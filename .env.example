# Enables embedding intent router + LLM NL→SQL (default ask path when set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_THRESHOLD=0.72
OPENAI_EMBED_MARGIN=0.03
# OPENAI_BASE_URL=
# CLOUDNOVA_EMBED_CACHE=data/processed/embed_centroids.json

# Optional HTTP API auth — when set, require X-API-Key or Bearer token
# CLOUDNOVA_API_KEY=

# Optional overrides
# CLOUDNOVA_CSV=data/cloudnova_invoices.csv
# CLOUDNOVA_DB=data/processed/invoices.duckdb

# Thin API (python -m app.api)
# API_HOST=127.0.0.1
# API_PORT=8000
